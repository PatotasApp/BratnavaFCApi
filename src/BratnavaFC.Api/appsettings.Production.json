{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  },
  "ReplayEvents": {
    "StreamKey": "replay_events",
    // Consumidor do stream "replays:uploaded" desligado: gastava comandos do Upstash em
    // loop com o stream vazio e o pipeline de replays hoje passa pelo outbox no banco.
    // Religar aqui ou via env var REPLAY_CONSUMER_ENABLED=true (não precisa de deploy).
    "ConsumerEnabled": false
  }
}
