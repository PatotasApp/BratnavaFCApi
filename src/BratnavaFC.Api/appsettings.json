{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "RedisConnection": ""
  },
  // ProjectId opcional: se ausente, e derivado do project_id do service account JSON
  // em FIREBASE_SERVICE_ACCOUNT_JSON.
  "Firebase": {
    "ProjectId": ""
  },
  "OpenAI": {
    "ApiKey": "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"
  },
  "Cloudflare": {
    "R2": {
      "AccessKey": "",
      "SecretKey": "",
      "EndpointUrl": "",
      // Um bucket por ambiente (development-images / production-images), compartilhado por
      // avatares e logos: os dois são públicos, e política de acesso é do bucket. Replay fica
      // fora, no goal-replays, porque é privado. O prefixo de cada tipo ("avatars", "logos")
      // vive no código — não varia entre ambientes. Valores reais vêm de secrets do Fly.
      "Images": {
        "BucketName": "",
        "PublicBaseUrl": ""
      }
    }
  }
}

